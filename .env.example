# ==========================================
# CyberShield AI — Environment Configuration
# ==========================================

# 1. Google Gemini API Key (Required for live Gemini LLM responses)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Frontend Backend URL Target (Used during build/runtime)
# In local development: http://localhost:8000/chat
# In production (e.g., Render/Railway): https://your-backend-app.onrender.com/chat
VITE_BACKEND_URL=http://localhost:8000/chat

# 3. Server Port (Set automatically by Render / Heroku / Railway)
PORT=8000
